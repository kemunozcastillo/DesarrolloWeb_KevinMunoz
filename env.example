PORT=3000

# Vault. El token lo entrega "npm run secretos" y solo puede leer lo que el
# gateway necesita. Nunca subas el .env con el token real.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
# 0 = consultar Vault en cada petición
VAULT_CACHE_SEGUNDOS=0

URL_AUTH=http://127.0.0.1:4100
URL_BACKEND=http://127.0.0.1:8000

# Cookie de sesión. COOKIE_SECURE=false solo para probar en localhost sin HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Sitios que pueden llamar al gateway desde el navegador, separados por coma
ORIGENES_PERMITIDOS=https://tu-usuario.github.io,http://localhost:5500
TIEMPO_MAXIMO_MS=10000
