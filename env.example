# Local con Docker:
#   docker run -d -p 27017:27017 --name mongo mongo:7
# MongoDB Atlas (gratis): mongodb+srv://usuario:clave@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=poke_fresh

# HashiCorp Vault: de aquí sale la credencial interna que exige la API.
# El token lo entrega "npm run secretos" en el gateway (solo puede leer su ruta).
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_RUTA_BACKEND=poke-fresh/backend
VAULT_CACHE_SEGUNDOS=30
