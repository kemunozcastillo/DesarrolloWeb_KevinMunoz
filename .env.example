# Copia este archivo como .env y cambia el valor de MONGO_ROOT_CLAVE por uno
# largo y aleatorio. El archivo .env no se sube al repositorio (.gitignore).
#
# La clave raíz de Mongo solo la usa vault-init para crear un usuario por
# servicio (cada uno con permiso únicamente sobre su base). Los servicios
# nunca la ven: leen su propio usuario y clave desde Vault.
MONGO_ROOT_USUARIO=raiz
MONGO_ROOT_CLAVE=reemplaza-esto-por-una-clave-larga-y-aleatoria

# true: cuentas de prueba, códigos de verificación en pantalla y datos de ejemplo.
MODO_DEMO=true
